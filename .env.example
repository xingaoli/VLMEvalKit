# VLMEvalKit Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# Common / OpenAI-compatible APIs
# =============================================================================
OPENAI_API_KEY=
OPENAI_API_BASE=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
OPENAI_API_VERSION=

# =============================================================================
# LMDeploy (Self-hosted Local Models)
# =============================================================================
# API Key for LMDeploy (can be any string, e.g., 'sk-xxx' or 'lmdeploy')
LMDEPLOY_API_KEY=

# API Base URL for your LMDeploy service
# Default: http://127.0.0.1:8000/v1/chat/completions
# Make sure to include /v1/chat/completions at the end
LMDEPLOY_API_BASE=

# Example for multiple models on different ports (use in config.py with partial):
# LMDEPLOY_API_BASE_8001=http://127.0.0.1:8001/v1/chat/completions
# LMDEPLOY_API_BASE_8002=http://127.0.0.1:8002/v1/chat/completions

# =============================================================================
# Chinese LLM APIs
# =============================================================================
# DashScope (Alibaba Cloud / Qwen)
DASHSCOPE_API_KEY=

# SenseNova (商汤)
SENSENOVA_API_KEY=

# Kimi VL (月之暗面)
KIMI_VL_API_KEY=
KIMI_VL_API_BASE=

# Doubao VL (字节跳动)
DOUBAO_VL_KEY=

# Taiyi (太乙)
TAICHU_API_KEY=

# BailingMM (百炼)
BAILINGMM_API_KEY=

# BlueLM
BLUELM_API_KEY=

# Taiyi
TAIYI_API_KEY=

# CloudWalk
CW_API_KEY=
CW_API_BASE=

# =============================================================================
# International LLM APIs
# =============================================================================
# Google / Gemini
GOOGLE_API_KEY=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ALLES=

# Reka
REKA_API_KEY=

# Together AI
TOGETHER_API_KEY=
TOGETHER_API_BASE=

# StepAI
STEPAI_API_KEY=

# GLM Vision
GLMV_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_API_BASE=

# Moonshot
MOONSHOT_API_KEY=

# Yi
YI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Baidu
BAIDU_API_KEY=

# Boyue
BOYUE_API_KEY=
BOYUE_API_BASE=

# SiliconFlow
SiliconFlow_API_KEY=

# O1
O1_API_KEY=
O1_API_BASE=

# =============================================================================
# Data & Cache Directories
# =============================================================================
# Local data directory for datasets
LMUData=

# Root directory for evaluation outputs
MMEVAL_ROOT=

# =============================================================================
# Runtime Options
# =============================================================================
# CUDA devices to use (e.g., "0,1,2,3")
CUDA_VISIBLE_DEVICES=

# Enable Chain-of-Thought reasoning (set to "1" to enable)
USE_COT=

# Split thinking format for inference
SPLIT_THINK=

# Prediction format
PRED_FORMAT=

# Evaluation format
EVAL_FORMAT=

# Proxy settings
http_proxy=
https_proxy=
NO_PROXY=

# =============================================================================
# Multi-processing
# =============================================================================
WORLD_SIZE=
